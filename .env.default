# Credential keys are deprecated, please use IAM roles.
# https://github.com/metaps/genova/wiki/IAM-policies-required-for-deployment.
# AWS_ACCOUNT_ID=
# AWS_ACCESS_KEY=

AWS_REGION=ap-northeast-1
AWS_SECRET_KEY=

# Private docker registry (optional, e.g. dhi.io)
DOCKER_REGISTRY_URL=
DOCKER_REGISTRY_USER=
DOCKER_REGISTRY_PASSWORD=

DOCKER_RESTART=always
REDIS_DB=0
REDIS_HOST=redis
REDIS_PORT=6379
RAILS_ENV=production
SSH_PRIVATE_KEY=.ssh/id_ed25519
THOR_SILENCE_DEPRECATION=true
MONGO_DB=production_genova
MONGO_DB_TEST=test_genova
MONGO_HOST=mongo
MONGO_PORT=27017
SECRET_KEY_BASE=please_rewrite_value
